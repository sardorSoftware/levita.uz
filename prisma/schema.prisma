generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url shu yerdan olib tashlandi (Prisma 7 talabi)
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id         String   @id @default(cuid())
  telegramId BigInt?  @unique
  firstName  String?
  lastName   String?
  username   String?
  phone      String?
  role       Role     @default(USER)
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  image    String?
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  title       String
  description String?
  price       Float
  oldPrice    Float?
  isUsed      Boolean     @default(false)
  inStock     Boolean     @default(true)
  image       String
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id        String      @id @default(cuid())
  userId    String?     // <-- O'zgartirildi: ixtiyoriy (optional) qilindi
  user      User?       @relation(fields: [userId], references: [id]) // <-- O'zgartirildi: user ham optional bo'ldi
  items     OrderItem[]
  total     Float
  status    OrderStatus @default(PENDING)
  address   String?
  phone     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}